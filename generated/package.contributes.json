{
  "contributes": {
    "commands": [
      {
        "command": "estate.commentToggle.line",
        "title": "Estate: Toggle Line Comment (`//`)",
        "shortTitle": "Toggle `//` line comments.",
        "category": "cmd",
        "icon": "$(comment)"
      },
      {
        "command": "estate.commentToggle.innerDoc",
        "title": "Estate: Toggle Rust Inner Doc Comment (`//!`)",
        "shortTitle": "Toggle `//!` inner doc comments.",
        "category": "cmd",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "estate.commentToggle.outerDoc",
        "title": "Estate: Toggle Rust Outer Doc Comment (`///`)",
        "shortTitle": "Toggle `///` outer doc comments.",
        "category": "cmd",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "estate.commentToggle.doc",
        "title": "Estate: Toggle JavaScript Doc Comment (`/** */`)",
        "shortTitle": "Toggle `/** */` doc comments.",
        "category": "cmd",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "estate.commentToggle.block",
        "title": "Estate: Toggle JavaScript Block Comment (`/* */`)",
        "shortTitle": "Toggle `/* */` block comments.",
        "category": "cmd",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "estate.cmdPalette.show",
        "title": "Estate: Open Command Palette",
        "shortTitle": "Find commands easily using the cmd palette",
        "category": "cmd",
        "icon": "$(zap)"
      },
      {
        "command": "estate.ui.quickPick",
        "title": "Estate: Open Quick Pick",
        "shortTitle": "Open quick picker",
        "icon": "$(zap)"
      },
      {
        "command": "estate.explore.options",
        "title": "Estate: View Options",
        "icon": "$(filter)"
      },
      {
        "command": "estate.bookmark.create",
        "title": "Estate: Create bookmark",
        "icon": "$(add)"
      },
      {
        "command": "estate.bookmark.read",
        "title": "Estate: View bookmark",
        "icon": "$(preview)"
      },
      {
        "command": "estate.bookmark.update",
        "title": "Estate: Edit bookmark",
        "icon": "$(preferences-open-settings)"
      },
      {
        "command": "estate.bookmark.delete",
        "title": "Estate: Delete bookmark",
        "icon": "$(trash)"
      },
      {
        "command": "estate.bookmark.filter",
        "title": "Estate: Filter bookmarks",
        "icon": "$(filter)"
      },
      {
        "command": "estate.settings.create",
        "title": "Estate: Create settings",
        "icon": "$(add)"
      },
      {
        "command": "estate.settings.read",
        "title": "Estate: View settings",
        "icon": "$(preview)"
      },
      {
        "command": "estate.settings.update",
        "title": "Estate: Edit settings",
        "icon": "$(edit)"
      },
      {
        "command": "estate.settings.delete",
        "title": "Estate: Delete settings",
        "icon": "$(trash)"
      },
      {
        "command": "estate.series.create",
        "title": "Estate: Create series",
        "icon": "$(add)"
      },
      {
        "command": "estate.series.read",
        "title": "Estate: View series",
        "icon": "$(preview)"
      },
      {
        "command": "estate.series.update",
        "title": "Estate: Edit series",
        "icon": "$(edit)"
      },
      {
        "command": "estate.series.delete",
        "title": "Estate: Delete series",
        "icon": "$(trash)"
      },
      {
        "command": "estate.anchor.view",
        "title": "Estate: View anchor",
        "icon": "$(preview)"
      },
      {
        "command": "ui.toggleMDPreview",
        "title": "Wiki Links: Preview Mode (Toggle)"
      },
      {
        "command": "flowify.analyzeLine",
        "title": "Estate: Analyze Subject"
      },
      {
        "command": "estate.snippet.create",
        "title": "Estate: Create snippet",
        "shortTitle": "Create a snippet in any language quick and easy.",
        "icon": "$(filter)"
      },
      {
        "command": "estate.snippet.read",
        "title": "Estate: Read snippet",
        "shortTitle": "View snippets",
        "icon": "$(filter)"
      },
      {
        "command": "estate.snippet.update",
        "title": "Estate: Update snippet",
        "shortTitle": "Update snippts",
        "icon": "$(filter)"
      },
      {
        "command": "estate.snippet.delete",
        "title": "Estate: Delete snippet",
        "shortTitle": "Delete snippet",
        "icon": "$(filter)"
      },
      {
        "command": "estate.anchor.pipeline",
        "title": "Estate: Anchor a pipeline's flow",
        "shortTitle": "Understand your code by noting steps through configuration files, branches, and variants",
        "category": "Estate",
        "icon": "$(type-hierarchy-sub)",
        "enablement": "estate.input"
      },
      {
        "command": "estate.ownership.show",
        "title": "Estate: Show Rust Ownership Analysis",
        "shortTitle": "Visualize ownership relationships and affected code regions",
        "category": "ownership",
        "icon": "$(references)",
        "enablement": "estate.rustAnalyzerReady"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "estate.explore.options",
          "when": "view == estateExplorer",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.create",
          "when": "view == estateExplorer",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "estate.bookmark.create",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "estate.bookmark.create",
          "when": "!estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.read",
          "when": "estate.hasAnchor && !estateExplorer.visible",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.delete",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.filter",
          "when": "estate.hasAnchor && estateExplorer.visible",
          "group": "navigation"
        },
        {
          "command": "estate.settings.create",
          "when": "estate.hasAnchor && estateExplorer.visible",
          "group": "navigation"
        },
        {
          "command": "estate.settings.read",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.settings.update",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.settings.delete",
          "group": "navigation"
        },
        {
          "command": "estate.ownership.show",
          "when": "editorLangId == rust",
          "group": "estate"
        }
      ],
      "view/item/context": [
        {
          "command": "estate.bookmark.create",
          "when": "viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "estate.bookmark.read",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.update",
          "when": "viewItem == folder",
          "group": "inline@2"
        },
        {
          "command": "estate.bookmark.delete",
          "when": "estate.hasAnchor",
          "group": "inline@3"
        },
        {
          "command": "estate.bookmark.filter",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.series.create",
          "group": "navigation"
        },
        {
          "command": "estate.series.read",
          "group": "navigation"
        },
        {
          "command": "estate.series.update",
          "group": "navigation"
        },
        {
          "command": "estate.series.delete",
          "group": "navigation"
        },
        {
          "command": "estate.anchor.pipeline",
          "when": "view == estateTree",
          "group": "estate@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "estate.bookmark.filter",
          "group": "navigation"
        },
        {
          "command": "estate.anchor.view",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "estate.anchor.pipeline",
          "when": "editorLangId == rust",
          "group": "estate@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "estate.commentToggle.line",
        "key": "cmd+/",
        "when": "editorTextFocus && !editorReadonly && (editorLangId == rust || editorLangId == javascript || editorLangId == typescript)"
      },
      {
        "command": "estate.commentToggle.innerDoc",
        "key": "f13 f13 cmd+/",
        "when": "editorLangId == rust && editorTextFocus && !editorReadonly"
      },
      {
        "command": "estate.commentToggle.outerDoc",
        "key": "f13 cmd+/",
        "when": "editorLangId == rust && editorTextFocus && !editorReadonly"
      },
      {
        "command": "estate.commentToggle.doc",
        "key": "f13 cmd+/",
        "when": "(editorLangId == javascript || editorLangId == typescript) && editorTextFocus && !editorReadonly"
      },
      {
        "command": "estate.commentToggle.block",
        "key": "f13 f13 cmd+/",
        "when": "(editorLangId == javascript || editorLangId == typescript) && editorTextFocus && !editorReadonly"
      },
      {
        "command": "estate.anchor.pipeline",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "estate.ownership.show",
        "key": "ctrl+alt+o",
        "when": "editorLangId == rust"
      }
    ]
  }
}