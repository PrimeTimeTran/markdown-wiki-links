{
  "contributes": {
    "commands": [
      
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "estate.series.create",
          "group": "plan"
        },
        {
          "command": "estate.series.read",
          "group": "plan"
        },
        {
          "command": "estate.series.update",
          "group": "plan"
        },
        {
          "command": "estate.series.delete",
          "group": "plan"
        },
        {
          "command": "estate.bookmark.create",
          "group": "plan"
        },
        {
          "command": "estate.bookmark.read",
          "group": "plan"
        },
        {
          "command": "estate.bookmark.update",
          "group": "plan"
        },
        {
          "command": "estate.bookmark.delete",
          "group": "plan"
        },
        {
          "command": "estate.anchor.pipeline",
          "when": "view == estateTree",
          "group": "estate@1"
        }
      ],
      "view/title": [
        {
          "command": "estate.filter",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "estate.anchor.view",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "estate.anchor.pipeline",
          "when": "editorLangId == rust",
          "group": "estate@1"
        }
      ],
      "editor/title": [
        {
          "command": "estate.show.ownership",
          "when": "editorLangId == rust",
          "group": "estate"
        }
      ]
    },
    "keybindings": [
      {
        "command": "estate.anchor.pipeline",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "estate.show.ownership",
        "key": "ctrl+alt+o",
        "when": "editorLangId == rust"
      }
    ]
  }
}
