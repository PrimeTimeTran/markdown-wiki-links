{
  "name": "a-markdown-wiki-links",
  "displayName": "Markdown Wiki Links",
  "publisher": "ltvan",
  "version": "0.3.9",
  "description": "Obsidian-style [[wiki-links]] between Markdown files in the workspace.",
  "license": "MIT",
  "scripts": {
    "commands:sync": "tsx ./src/cmd/command-sync.ts",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch; echo 'watching'",
    "compile:tests": "tsc -p ./",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test",
    "test:pretest": "pnpm format:check && pnpm lint && pnpm build && pnpm compile:tests",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "mocha --config .mocharc.unit.cjs",
    "test:e2e": "vscode-test",
    "package": "vsce package --no-dependencies",
    "loi-test2": "pnpm test:e2e && pnpm test",
    "loi-test": "pnpm build && pnpm exec vscode-test --label comments",
    "publish": "vsce publish --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ltvan/m.rustarkdown-wiki-links.git"
  },
  "bugs": {
    "url": "https://github.com/ltvan/markdown-wiki-links/issues"
  },
  "homepage": "https://github.com/ltvan/markdown-wiki-links#readme",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "wiki",
    "wikilinks",
    "obsidian",
    "markdown",
    "links",
    "notes",
    "zettelkasten"
  ],
  "engines": {
    "vscode": "^1.131.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:rust",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:js",
    "onLanguage:ts",
    "workspaceContains:**/*.{md,markdown}",
    "workspaceContains:**/*.rs",
    "workspaceContains:**/*.{ts,mjs}",
    "workspaceContains:**/*.{js,cjs}"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Wiki-link click-to-follow, hover, completion, and preview embeds work in untrusted workspaces. Rename-aware link rewriting is disabled until the workspace is trusted (it modifies files on disk)."
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "views": {
      "estate": [
        {
          "icon": "resources/activiyBar.svg",
          "id": "estateExplorer",
          "name": "Estate"
        }
      ]
    },
    "keybindings": [
      {
        "command": "estate.commentToggle.line",
        "key": "cmd+/",
        "when": "editorTextFocus && !editorReadonly && (editorLangId == rust || editorLangId == javascript || editorLangId == typescript)"
      },
      {
        "command": "estate.commentToggle.innerDoc",
        "key": "f13 f13 cmd+/",
        "when": "editorLangId == rust && editorTextFocus && !editorReadonly"
      },
      {
        "command": "estate.commentToggle.outerDoc",
        "key": "f13 cmd+/",
        "when": "editorLangId == rust && editorTextFocus && !editorReadonly"
      },
      {
        "command": "estate.commentToggle.doc",
        "key": "f13 cmd+/",
        "when": "(editorLangId == javascript || editorLangId == typescript) && editorTextFocus && !editorReadonly"
      },
      {
        "command": "estate.commentToggle.block",
        "key": "f13 f13 cmd+/",
        "when": "(editorLangId == javascript || editorLangId == typescript) && editorTextFocus && !editorReadonly"
      },
      {
        "command": "estate.anchor.pipeline",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "estate.ownership.show",
        "key": "ctrl+alt+o",
        "when": "editorLangId == rust"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "estate.pipeline.start",
          "when": "view == estateExplorer && !estate.leader || estate.leader == 0",
          "group": "navigation"
        },
        {
          "command": "estate.pipeline.stop",
          "when": "view == estateExplorer && estate.leader == 1",
          "group": "navigation"
        },
        {
          "command": "estate.pipeline.clear",
          "when": "view == estateExplorer && estate.leader == 2",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.create",
          "when": "view == estateExplorer",
          "group": "navigation"
        },
        {
          "command": "estate.explore.options",
          "when": "view == estateExplorer",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "estate.settings.create",
          "when": "estate.hasAnchor && estateExplorer.visible",
          "group": "navigation"
        },
        {
          "command": "estate.settings.read",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.settings.update",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.create",
          "when": "!estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.read",
          "when": "estate.hasAnchor && !estateExplorer.visible",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.delete",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.filter",
          "when": "estate.hasAnchor && estateExplorer.visible",
          "group": "navigation"
        },
        {
          "command": "estate.ownership.show",
          "when": "!estate.hasAnchor && editorLangId == rust",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "estate.settings.create",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.settings.delete",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.delete",
          "when": "estate.hasAnchor",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "estate.series.create",
          "group": "navigation"
        },
        {
          "command": "estate.series.read",
          "group": "navigation"
        },
        {
          "command": "estate.series.update",
          "group": "navigation"
        },
        {
          "command": "estate.series.delete",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.create",
          "when": "viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "estate.bookmark.read",
          "when": "estate.hasAnchor",
          "group": "navigation"
        },
        {
          "command": "estate.bookmark.update",
          "when": "viewItem == folder",
          "group": "inline@2"
        },
        {
          "command": "estate.bookmark.delete",
          "when": "estate.hasAnchor",
          "group": "inline@3"
        },
        {
          "command": "estate.anchor.pipeline",
          "when": "view == estateTree",
          "group": "estate@1"
        },
        {
          "command": "estate.bookmark.filter",
          "when": "estate.hasAnchor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "estate.bookmark.create",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "estate.bookmark.filter",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "estate.commentToggle.line",
        "title": "Estate: Toggle Line Comment '//'",
        "shortTitle": "Toggle `//` line comments.",
        "category": "comment",
        "icon": "$(comment)"
      },
      {
        "command": "estate.commentToggle.innerDoc",
        "title": "Estate: Toggle Rust Inner Doc Comment '//!'",
        "shortTitle": "Toggle `//!` inner doc comments.",
        "category": "comment",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "estate.commentToggle.outerDoc",
        "title": "Estate: Toggle Rust Outer Doc Comment '///'",
        "shortTitle": "Toggle `///` outer doc comments.",
        "category": "comment",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "estate.commentToggle.doc",
        "title": "Estate: Toggle JavaScript Doc Comment '/** */'",
        "shortTitle": "Toggle `/** */` doc comments.",
        "category": "comment",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "estate.commentToggle.block",
        "title": "Estate: Toggle JavaScript Block Comment '/* */'",
        "shortTitle": "Toggle `/* */` block comments.",
        "category": "comment",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "estate.cmdPalette.show",
        "title": "Estate: Open Command Palette",
        "shortTitle": "Find commands easily using the cmd palette",
        "category": "cmd",
        "icon": "$(zap)"
      },
      {
        "command": "estate.pipeline.start",
        "title": "Estate: Development Start",
        "shortTitle": "Start pipeline",
        "category": "pipeline",
        "group": "pipeline",
        "icon": "$(debug-start)"
      },
      {
        "command": "estate.pipeline.stop",
        "title": "Estate: Development Stop",
        "shortTitle": "Stop pipeline",
        "category": "pipeline",
        "group": "pipeline",
        "icon": "$(debug-stop)"
      },
      {
        "command": "estate.pipeline.clear",
        "title": "Estate: Development Clear",
        "shortTitle": "Clear pipeline",
        "category": "pipeline",
        "group": "pipeline",
        "icon": "$(debug-console-clear-all)"
      },
      {
        "command": "estate.settings.create",
        "title": "Estate: Create settings",
        "icon": "$(add)"
      },
      {
        "command": "estate.settings.read",
        "title": "Estate: View settings",
        "icon": "$(gear)",
        "enablement": "estateExplorer.visible"
      },
      {
        "command": "estate.settings.update",
        "title": "Estate: Edit settings",
        "icon": "$(edit)"
      },
      {
        "command": "estate.settings.delete",
        "title": "Estate: Delete settings",
        "icon": "$(trash)"
      },
      {
        "command": "estate.series.create",
        "title": "Estate: Create series",
        "icon": "$(add)"
      },
      {
        "command": "estate.series.read",
        "title": "Estate: View series",
        "icon": "$(view)"
      },
      {
        "command": "estate.series.update",
        "title": "Estate: Edit series",
        "icon": "$(edit)"
      },
      {
        "command": "estate.series.delete",
        "title": "Estate: Delete series",
        "icon": "$(trash)"
      },
      {
        "command": "estate.bookmark.create",
        "title": "Estate: Create bookmark",
        "group": "bookmarks@1",
        "icon": "$(add)"
      },
      {
        "command": "estate.bookmark.read",
        "title": "Estate: View bookmark",
        "group": "bookmarks@2",
        "icon": "$(preview)"
      },
      {
        "command": "estate.bookmark.update",
        "title": "Estate: Edit bookmark",
        "group": "bookmarks@3",
        "icon": "$(preferences-open-settings)"
      },
      {
        "command": "estate.bookmark.delete",
        "title": "Estate: Delete bookmark",
        "group": "bookmarks@4",
        "icon": "$(trash)"
      },
      {
        "command": "ui.toggleMDPreview",
        "title": "Wiki Links: Preview Mode (Toggle)"
      },
      {
        "command": "flowify.analyzeLine",
        "title": "Estate: Analyze Subject"
      },
      {
        "command": "estate.snippet.create",
        "title": "Estate: Create snippet",
        "shortTitle": "Open a scratch pad for brainstorming ideas out quick and easy.",
        "icon": "$(add)"
      },
      {
        "command": "estate.snippet.read",
        "title": "Estate: Read snippet",
        "shortTitle": "View snippets",
        "icon": "$(view)"
      },
      {
        "command": "estate.snippet.update",
        "title": "Estate: Update snippet",
        "shortTitle": "Update snippets",
        "icon": "$(edit)"
      },
      {
        "command": "estate.snippet.delete",
        "title": "Estate: Delete snippet",
        "shortTitle": "Delete snippet",
        "icon": "$(trash)"
      },
      {
        "command": "estate.anchor.pipeline",
        "title": "Estate: Anchor a pipeline's flow",
        "shortTitle": "Understand your code by noting steps through configuration files, branches, and variants",
        "category": "Estate",
        "icon": "$(type-hierarchy-sub)",
        "enablement": "estate.input"
      },
      {
        "command": "estate.bookmark.filter",
        "title": "Estate: Filter bookmarks",
        "icon": "$(filter)"
      },
      {
        "command": "estate.explore.options",
        "title": "Estate: View Options",
        "icon": "$(filter)"
      },
      {
        "command": "estate.ui.quickPick",
        "title": "Estate: Open Quick Pick",
        "shortTitle": "Quick Pick from the command palette",
        "icon": "$(zap)"
      },
      {
        "command": "estate.ownership.show",
        "title": "Estate: Show Rust Ownership Analysis",
        "shortTitle": "Visualize ownership relationships and affected code regions",
        "category": "ownership",
        "icon": "$(references)",
        "enablement": "estate.rustAnalyzerReady"
      }
    ],
    "configuration": {
      "title": "Wiki Links",
      "properties": {
        "flowify.log.level": {
          "type": "string",
          "default": "info",
          "description": "Log Level"
        },
        "flowify.namespace": {
          "type": "string",
          "default": "app",
          "description": "Name space"
        },
        "flowify.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Flowify"
        },
        "flowify.dim.upstream": {
          "type": "boolean",
          "default": true,
          "description": "Dim code unrelated to upstream ownership flow"
        },
        "flowify.dim.downstream": {
          "type": "boolean",
          "default": true,
          "description": "Dim code unrelated to downstream ownership flow"
        },
        "flowify.display-inline-anchors": {
          "type": "boolean",
          "default": true,
          "description": "Enable Flowify"
        },
        "wikiLinks.showInOutputChannel": {
          "type": "boolean",
          "default": true,
          "description": "Show output messages in the extension output channel."
        },
        "wikiLinks.level": {
          "type": "string",
          "default": "info",
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "description": "Sets the logging or display level for wiki links."
        },
        "wikiLinks.show": {
          "type": "boolean",
          "default": true,
          "description": "Controls whether wiki links are enabled or shown."
        },
        "wikiLinks.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Toggles the status bar indicator for wiki links."
        },
        "wikiLinks.showInNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show notifications for events and status updates."
        },
        "wikiLinks.showInProblems": {
          "type": "boolean",
          "default": true,
          "description": "Report diagnostics in the VS Code Problems panel."
        },
        "wikiLinks.showInDebugConsole": {
          "type": "boolean",
          "default": false,
          "description": "Log runtime details to the Debug Console."
        },
        "wikiLinks.showInTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Print outputs directly to the integrated terminal."
        },
        "wikiLinks.showInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Enable features inside the main text editor view."
        },
        "wikiLinks.showInEditorGutter": {
          "type": "boolean",
          "default": true,
          "description": "Display indicators in the editor gutter."
        },
        "wikiLinks.showInEditorInline": {
          "type": "boolean",
          "default": false,
          "description": "Render details inline directly inside source text."
        },
        "wikiLinks.showInEditorHover": {
          "type": "boolean",
          "default": true,
          "description": "Show rich contents on mouse hover in the editor."
        },
        "wikiLinks.showInEditorPeek": {
          "type": "boolean",
          "default": false,
          "description": "Enable support for Peek views."
        },
        "wikiLinks.showInEditorCodeLens": {
          "type": "boolean",
          "default": false,
          "description": "Display CodeLens action lines above symbols."
        },
        "wikiLinks.showInEditorInlayHints": {
          "type": "boolean",
          "default": false,
          "description": "Render subtle inlay hints inside the editor."
        },
        "wikiLinks.showInEditorDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Apply text and background highlighting decorations."
        },
        "wikiLinks.showInEditorMinimap": {
          "type": "boolean",
          "default": false,
          "description": "Highlight markers inside the editor minimap."
        },
        "wikiLinks.showInEditorOverviewRuler": {
          "type": "boolean",
          "default": false,
          "description": "Display indicators on the right-side overview ruler."
        },
        "wikiLinks.showInEditorGlyphMargin": {
          "type": "boolean",
          "default": false,
          "description": "Render glyph icons in the far left margin."
        },
        "wikiLinks.showInEditorLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Alter line number displays or highlights."
        },
        "wikiLinks.showInEditorWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Control whitespace visualization options."
        },
        "wikiLinks.showInEditorIndentGuides": {
          "type": "boolean",
          "default": false,
          "description": "Control indentation guide visibility settings."
        },
        "wikiLinks.embed.maxDepthx": {
          "type": "number",
          "default": 3,
          "description": "Maximum recursion depth when embedding wiki links."
        },
        "wikiLinks.embed.maxDepth": {
          "type": "number",
          "default": 3,
          "description": "Maximum recursion depth when expanding nested ![[...]] embeds in the Markdown preview. Beyond this depth an embed renders a depth-exceeded notice instead of expanding."
        },
        "wikiLinks.indexMaxFiles": {
          "type": "number",
          "default": 50000,
          "description": "Soft cap on indexed files. A workspace above the cap shows a notification and only the first N files are indexed."
        },
        "wikiLinks.hover.imageMaxHeight": {
          "type": "number",
          "default": 240,
          "description": "Maximum height (px) for image previews in hover popups. VSCode does not expose its hover height limit to extensions: lower this if previews are clipped, raise it if there is empty space below the image."
        },
        "wikiLinks.index.excludeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            "node_modules",
            "target",
            ".hg",
            ".svn",
            ".bzr",
            "bower_components"
          ],
          "description": "Folder names excluded from the wiki-link index. Any file inside a folder with one of these names is not indexed, so wiki-links never resolve into vendor or VCS directories. Match is on the folder name, at any depth. Rename link-rewriting skips these folders too."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "estate",
          "title": "Estate",
          "icon": "resources/activiyBar.svg"
        },
        {
          "id": "alias",
          "title": "Alias",
          "icon": "resources/alias.svg"
        },
        {
          "id": "binding",
          "title": "Binding",
          "icon": "resources/binding.svg"
        },
        {
          "id": "identifer",
          "title": "Identifer",
          "icon": "resources/identifier.svg"
        },
        {
          "id": "shadow",
          "title": "Shadow",
          "icon": "resources/shadow.svg"
        },
        {
          "id": "symbol",
          "title": "Symbol",
          "icon": "resources/symbol.svg"
        },
        {
          "id": "declaration",
          "title": "Declaration",
          "icon": "resources/declaration.svg"
        },
        {
          "id": "binding",
          "title": "Binding",
          "icon": "resources/binding.svg"
        },
        {
          "id": "shadowing",
          "title": "Shadowing",
          "icon": "resources/shadowing.svg"
        },
        {
          "id": "memory",
          "title": "Memory",
          "icon": "resources/memory.svg"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.estate/anchors.json"
        ],
        "url": "./schemas/anchors.schema.json"
      }
    ]
  },
  "recommendations": [
    "vscode-icons-team.vscode-icons"
  ],
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.1",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import": "^2.32.0",
    "markdown-it": "^14.1.1",
    "mocha": "^11.8.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@primetimetran/logger": "workspace:*",
    "and": "^0.0.3",
    "build": "^0.1.4",
    "highlight.js": "^11.11.1",
    "run": "^1.5.0",
    "tsx": "^4.23.1"
  }
}
